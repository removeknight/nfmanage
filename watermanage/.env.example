POSTGRES_DB=watermanage
POSTGRES_USER=watermanage
POSTGRES_PASSWORD=replace-with-a-long-random-password
APP_PORT=8080
SERVER_NAME=_
CORS_ORIGINS=*
DATABASE_URL=postgresql+psycopg://watermanage:replace-with-a-long-random-password@127.0.0.1:5432/watermanage
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# mock keeps local page testing available; use wechat with real credentials in production.
MINI_AUTH_MODE=wechat
SEED_DEMO_DATA=false
# static is recommended on cloud servers; preview retains the Lab process layout.
FRONTEND_MODE=static
# Persistent image storage outside the Git checkout on deployed servers.
UPLOAD_DIR=/var/lib/watermanage/uploads
