<page-meta root-font-size="{{readingRootFont}}px"/>
<view class="merchant-page {{readingLayoutClass}}"><view wx:if="{{loading}}" class="empty">正在加载…</view><view wx:if="{{error}}" class="error">{{error}}</view><block wx:if="{{order}}">
  <view class="card"><view class="row"><view class="title">{{order.status}}</view><view class="status">到店提货</view></view><view class="subtitle" style="margin-bottom:0">下单时间 {{order.timeText}}</view><view class="order-no">{{order.order_no}}</view><view class="divider"/><view class="muted">提货核销码</view><view class="code">{{order.pickup_code}}</view></view>
  <view class="card"><view class="section-title">客户信息</view><view class="row"><view class="grow">{{order.contact_name}}<view class="line">{{order.contact_phone}}</view></view><view class="secondary" bindtap="call">拨号</view></view><view wx:if="{{order.note}}" class="muted">备注：{{order.note}}</view></view>
  <view class="card"><view class="section-title">商品明细</view><view wx:for="{{order.items}}" wx:key="product_id" class="line row"><view class="grow">{{item.name}}<view class="muted">{{item.brand}} · {{item.capacity}} · ¥{{item.priceText}} × {{item.quantity}}</view></view><text>¥{{item.subtotalText}}</text></view><view class="divider"/><view class="row line"><text class="muted">商品总额</text><text>¥{{order.originalText}}</text></view><view class="row line"><text class="muted">优惠券</text><text>−¥{{order.discountText}}</text></view><view class="row line"><text>优惠后应收</text><text class="amount">¥{{order.totalText}}</text></view><view class="row line"><text>实际已收</text><text>¥{{order.receivedText}} · {{order.payment_status}}</text></view><view wx:if="{{order.paidText}}" class="muted">收款时间 {{order.paidText}}</view></view>
  <block wx:if="{{order.status === '待提货' || order.status === '待配送' || order.status === '配送中'}}"><view class="primary {{busy ? 'disabled' : ''}}" data-action="redeem" bindtap="act">{{busy ? '正在处理…' : '确认收款并提货核销'}}</view><view wx:if="{{manager}}" class="danger {{busy ? 'disabled' : ''}}" style="margin-top:20rpx" data-action="cancel" bindtap="act">取消订单并退库退券</view></block>
</block></view>
