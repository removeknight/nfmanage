<page-meta root-font-size="{{readingRootFont}}px"/>
<view class="merchant-page {{readingLayoutClass}}"><view class="title">商品库存</view><view class="subtitle">查看当前可售库存，入库及调价请使用电脑后台</view><input class="search" value="{{query}}" bindinput="input" placeholder="搜索品名、品牌或品类"/><view class="tabs"><view class="tab {{lowOnly ? 'active' : ''}}" bindtap="toggle">{{lowOnly ? '✓ 只看库存不足' : '只看库存不足'}}</view></view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{loading}}" class="empty">正在加载…</view><view wx:elif="{{!displayed.length}}" class="empty">暂无匹配商品</view><view wx:for="{{displayed}}" wx:key="id" class="card row"><view class="grow"><view class="section-title">{{item.name}}</view><view class="muted">{{item.brand}} · {{item.capacity}} · {{item.category}}</view><view class="muted">售价 ¥{{item.sell_price}} / {{item.unit}}</view></view><view><view class="stock {{item.stock <= item.warning_stock ? 'amount' : ''}}">{{item.stock}}<text class="muted"> {{item.unit}}</text></view><view class="muted">{{item.stock <= item.warning_stock ? '库存不足' : '库存充足'}}</view></view></view></view>
