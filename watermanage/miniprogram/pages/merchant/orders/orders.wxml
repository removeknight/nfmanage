<view class="merchant-page">
  <view class="card"><view class="section-title">快速核销</view><view class="muted" style="margin-bottom:20rpx">核销码 6 位，或手机尾号后 4 位</view><view class="row search" style="margin-bottom:0"><input type="number" maxlength="6" value="{{lookup}}" data-field="lookup" bindinput="input" bindconfirm="lookup" placeholder="输入数字查单"/><view class="primary {{searching ? 'disabled' : ''}}" bindtap="lookup">查单</view></view></view>
  <block wx:if="{{candidates !== null}}"><view class="row section-title"><text>匹配 {{candidates.length}} 笔订单</text><text class="link" bindtap="clearCandidates">收起</text></view><view wx:if="{{!candidates.length}}" class="empty">未找到待提货订单</view><view wx:for="{{candidates}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="detail"><view class="row"><view>{{item.contact_name}} · {{item.contact_phone}}</view><view class="status">{{item.status}}</view></view><view class="line">核销码 {{item.pickup_code}} · ¥{{item.totalText}}</view><view class="order-no">{{item.order_no}} ›</view></view><view class="divider"/></block>
  <view class="title">小程序订单</view><view class="subtitle">默认展示待提货订单，列表自动更新</view>
  <view class="row search"><input type="number" maxlength="40" value="{{phone}}" data-field="phone" bindinput="input" bindconfirm="search" placeholder="手机号包含搜索"/><view class="secondary" bindtap="search">搜索</view></view>
  <view class="tabs"><view wx:for="{{statuses}}" wx:key="*this" class="tab {{status === item ? 'active' : ''}}" data-status="{{item}}" bindtap="selectStatus">{{item}}</view></view>
  <view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{loading}}" class="empty">正在加载…</view><view wx:elif="{{!orders.length}}" class="empty">暂无相关订单</view>
  <view wx:for="{{orders}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="detail"><view class="row"><view class="grow">{{item.contact_name}}<view class="muted">{{item.contact_phone}}</view></view><view class="status">{{item.status}} ›</view></view><view class="divider"/><view wx:for="{{item.items}}" wx:for-item="line" wx:key="product_id" class="line row"><view class="grow">{{line.brand}} {{line.name}}<view class="muted">{{line.capacity}}</view></view><text>×{{line.quantity}}</text></view><view class="row"><view class="muted">{{item.timeText}}</view><view class="amount">¥{{item.totalText}}</view></view></view>
  <view wx:if="{{orders.length === 500}}" class="muted">最多展示最近 500 笔，请使用手机号及状态缩小范围。</view>
</view>
