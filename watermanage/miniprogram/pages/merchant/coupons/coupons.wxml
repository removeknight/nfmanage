<view class="merchant-page"><view class="title">给客户发券</view><view class="subtitle">每次发放一张，批量发券与新用户券设置请使用电脑后台</view><view wx:if="{{error}}" class="error">{{error}}</view><view class="card"><view class="section-title">选择客户</view><view wx:if="{{selected}}" class="row"><view class="grow">{{selected.name}}<view class="muted">{{selected.phone}}</view></view><view class="link" bindtap="clear">更换</view></view><block wx:else><view class="row search"><input value="{{query}}" data-field="query" bindinput="input" bindconfirm="search" placeholder="姓名或手机号"/><view class="secondary" bindtap="search">搜索</view></view><view wx:if="{{loading}}" class="empty">正在加载…</view><view wx:elif="{{!customers.length}}" class="empty">没有匹配的小程序客户</view><scroll-view scroll-y style="max-height:440rpx"><view wx:for="{{customers}}" wx:key="id" class="customer row" data-id="{{item.id}}" bindtap="select"><view>{{item.name}}<view class="muted">{{item.phone}}</view></view><text class="link">选择</text></view></scroll-view><view class="muted">最多列出最近 100 位，可搜索定位。</view></block></view><view class="card"><view class="field"><text class="label">优惠券名称</text><input data-field="title" value="{{title}}" maxlength="80" bindinput="input"/></view><view class="field"><text class="label">金额（元）</text><input type="digit" data-field="amount" value="{{amount}}" bindinput="input" placeholder="例如 5.00"/></view><view class="field"><text class="label">有效天数</text><input type="number" data-field="days" value="{{days}}" bindinput="input" placeholder="默认 7 天"/></view><text class="label">适用商品</text><view class="tabs"><view class="tab {{usage === 'unrestricted' ? 'active' : ''}}" data-usage="unrestricted" bindtap="usage">无门槛</view><view class="tab {{usage === 'large_bucket' ? 'active' : ''}}" data-usage="large_bucket" bindtap="usage">大桶水</view></view><view class="muted">大桶水券仅抵扣品类为“大桶水”的商品金额。</view></view><view class="primary {{busy ? 'disabled' : ''}}" bindtap="submit">{{busy ? '正在处理…' : '确认发放'}}</view></view>
