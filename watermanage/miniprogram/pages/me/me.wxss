page { background: #f6f7f5; color: #24342f; }
.me-page { padding: 30rpx 26rpx 60rpx; }
.identity-card { display: flex; flex-wrap: wrap; gap: 20rpx; align-items: center; padding: 30rpx 22rpx; border-radius: 20rpx; background: #eaf2ee; }
.avatar { display: flex; align-items: center; justify-content: center; flex: none; width: 2.75rem; height: 2.75rem; border-radius: 50%; background: #356e60; color: #fff; font-size: 1.25rem; }
.identity-info { flex: 1 1 220rpx; min-width: 0; overflow-wrap: anywhere; }
.identity-name { font-size: 1.1875rem; font-weight: 650; }
.identity-phone { margin-top: 9rpx; color: #56685f; font-size: 0.9375rem; }
.profile-link { display: flex; align-items: center; flex: none; min-height: 44px; max-width: 100%; padding: 10rpx; color: #356e60; font-size: 1rem; }
.address-card { margin-top: 16rpx; padding: 24rpx; border: 1rpx solid #e7ece8; border-radius: 16rpx; background: #fff; font-size: 1rem; line-height: 1.6; }
.muted { color: #56685f; font-size: 0.9375rem; }
.orders-entry { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; min-height: 44px; margin-top: 18rpx; padding: 26rpx; border: 1rpx solid #e7ece8; border-radius: 16rpx; background: #fff; }
.orders-entry > view { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.orders-entry > text { flex: none; }
.entry-title { font-size: 1.125rem; font-weight: 600; }.entry-copy { margin-top: 9rpx; color: #56685f; font-size: 0.9375rem; }.orders-entry > text { color: #56685f; font-size: 1.375rem; }
.coupon-heading { margin-top: 34rpx; font-size: 1.1875rem; font-weight: 650; }.coupon-heading text { display: block; margin-top: 8rpx; color: #56685f; font-size: 0.9375rem; font-weight: normal; }
.coupon-tabs { display: flex; flex-wrap: wrap; margin: 22rpx 0; gap: 16rpx; }.coupon-tab { display: flex; align-items: center; min-height: 44px; padding: 12rpx 26rpx; border-radius: 28rpx; background: #fff; color: #56685f; font-size: 1rem; }.coupon-tab.active { background: #356e60; color: #fff; }
.empty-copy { padding: 60rpx 0; text-align: center; color: #56685f; font-size: 1rem; }
.coupon-card { display: flex; flex-wrap: wrap; gap: 20rpx; align-items: center; margin-bottom: 16rpx; padding: 24rpx; border: 1rpx solid #e2eae4; border-radius: 16rpx; background: #fff; }
.coupon-value { max-width: 100%; overflow-wrap: anywhere; color: #a64e32; font-size: 1.375rem; font-weight: 700; }.coupon-value text { margin-right: 4rpx; font-size: 1rem; }
.coupon-info { flex: 1 1 240rpx; min-width: 0; overflow-wrap: anywhere; }.coupon-name { font-size: 1.125rem; font-weight: 600; }.coupon-rule,.coupon-date { margin-top: 9rpx; color: #56685f; font-size: .9375rem; }.use-coupon { display: flex; align-items: center; justify-content: center; min-height: 44px; max-width: 100%; padding: 12rpx 20rpx; border-radius: 12rpx; background: #edf4ef; color: #356e60; font-size: 1rem; }.coupon-state { color: #56685f; font-size: .9375rem; }.inactive { background: #f0f3ef; }
.address-card { overflow-wrap: anywhere; }
.legal-links { display: flex; flex-wrap: wrap; gap: 12rpx 32rpx; margin-top: 18rpx; color: #356e60; font-size: 1rem; }
.legal-links text { display: flex; align-items: center; min-height: 44px; }
