page { background: #f6f7f5; color: #24342f; }
.profile-page { box-sizing: border-box; width: 100%; padding: 42rpx 30rpx 100rpx; }
.title { font-size: 34rpx; font-weight: 700; }
.subtitle { margin: 12rpx 0 34rpx; color: #849189; font-size: 23rpx; }
.profile-form { padding: 28rpx; border: 1rpx solid #e5ece7; border-radius: 20rpx; background: #fff; }
.form-group { display: block; margin-bottom: 30rpx; }
.form-group:last-child { margin-bottom: 0; }
.label { margin-bottom: 14rpx; font-size: 24rpx; color: #52655b; }
.form-input { display: block; box-sizing: border-box; width: 100%; height: 92rpx; min-height: 92rpx; padding: 0 22rpx; border: 1rpx solid #e4ebe6; border-radius: 12rpx; background: #f8faf8; font-size: 27rpx; line-height: normal; }
.form-address { display: block; box-sizing: border-box; width: 100%; height: 160rpx; min-height: 160rpx; padding: 20rpx 22rpx; border: 1rpx solid #e4ebe6; border-radius: 12rpx; background: #f8faf8; font-size: 27rpx; line-height: 1.5; }
.save-btn { display: flex; align-items: center; justify-content: center; height: 88rpx; margin-top: 30rpx; border-radius: 44rpx; background: #356e60; color: #fff; font-size: 27rpx; line-height: 1; }
.save-btn::after { border: none; }
.test-hint { margin-top: 20rpx; color: #99a39d; font-size: 21rpx; text-align: center; }
