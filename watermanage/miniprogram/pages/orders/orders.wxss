page { min-height: 100%; background: #f4f7fa; color: #203c50; }
.page { padding: 24rpx; }
.empty { padding: 100rpx 0; color: #8da1ac; text-align: center; font-size: 25rpx; }
.empty-state { padding: 160rpx 20rpx; text-align: center; }
.empty-icon { width: 112rpx; height: 112rpx; line-height: 112rpx; margin: 0 auto 25rpx; border-radius: 50%; background: #e0f3f1; color: #50aaa3; font-size: 42rpx; }
.empty-title { font-size: 30rpx; font-weight: 700; }
.empty-copy { margin: 13rpx 0 28rpx; color: #8ca0ac; font-size: 22rpx; }
.shop-btn { display: inline-block; min-width: 180rpx; height: 70rpx; padding: 0 30rpx; border-radius: 40rpx; background: #268f99; color: white; font-size: 24rpx; line-height: 70rpx; }
.shop-btn::after, .cancel-btn::after { border: none; }
.order-card { margin-bottom: 20rpx; padding: 26rpx 24rpx 20rpx; border-radius: 20rpx; background: #fff; box-shadow: 0 6rpx 22rpx #12344a0b; }
.order-head { display: flex; justify-content: space-between; align-items: center; }
.order-label { margin-right: 10rpx; color: #91a3ad; font-size: 20rpx; }
.order-no { color: #547083; font-size: 21rpx; }
.status { font-size: 22rpx; font-weight: 600; }
.status.pending { color: #e28b4d; }
.status.done { color: #32a18f; }
.status.cancelled { color: #9baab1; }
.order-time { margin-top: 15rpx; padding-bottom: 18rpx; border-bottom: 1rpx solid #eff2f4; color: #9aabb4; font-size: 20rpx; }
.order-item { display: flex; justify-content: space-between; align-items: center; padding: 18rpx 0; }
.item-name { font-size: 24rpx; font-weight: 600; }
.item-spec { margin-top: 7rpx; color: #97a8b1; font-size: 20rpx; }
.item-price { color: #516c7c; font-size: 22rpx; }
.order-address, .order-note { margin-top: 8rpx; color: #8297a4; font-size: 20rpx; line-height: 1.5; }
.order-foot { display: flex; justify-content: space-between; align-items: center; margin-top: 20rpx; padding-top: 18rpx; border-top: 1rpx solid #eff2f4; }
.order-hint { color: #9babb3; font-size: 19rpx; }
.order-sum { color: #7f919b; font-size: 22rpx; }
.order-sum text { margin-left: 7rpx; color: #e57955; font-size: 29rpx; font-weight: 700; }
.cancel-btn { width: auto; height: 56rpx; margin: 17rpx 0 0 auto; padding: 0 22rpx; border: 1rpx solid #dce5e9; border-radius: 30rpx; background: white; color: #778c97; font-size: 20rpx; line-height: 54rpx; }
