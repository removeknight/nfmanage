page { min-height: 100%; background: #f6f7f5; color: #24342f; }
.page { padding: 24rpx 26rpx; }
.empty { padding: 90rpx 0; color: #87938e; text-align: center; font-size: 23rpx; }
.empty-state { padding: 150rpx 20rpx; text-align: center; }
.empty-icon { width: 104rpx; height: 104rpx; line-height: 104rpx; margin: 0 auto 22rpx; border-radius: 50%; background: #eaf2ee; color: #568574; font-size: 40rpx; }
.empty-title { color: #34443e; font-size: 28rpx; font-weight: 650; }
.empty-copy { margin: 12rpx 0 26rpx; color: #87938e; font-size: 21rpx; }
.shop-btn { display: inline-flex; align-items: center; justify-content: center; min-width: 170rpx; height: 66rpx; padding: 0 26rpx; border-radius: 34rpx; background: #356e60; color: #fff; font-size: 21rpx; line-height: 1; }
.shop-btn::after, .cancel-btn::after { border: 0; }
.order-card { margin-bottom: 16rpx; padding: 22rpx; border: 1rpx solid #e8ede9; border-radius: 17rpx; background: #fff; }
.order-head { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.order-label { margin-right: 8rpx; color: #8a9690; font-size: 18rpx; }
.order-no { color: #53665e; font-size: 19rpx; }
.status { flex: none; font-size: 20rpx; font-weight: 600; }
.status.pending { color: #a87938; }
.status.done { color: #4c8b73; }
.status.cancelled { color: #909b95; }
.order-time { margin-top: 13rpx; padding-bottom: 14rpx; border-bottom: 1rpx solid #edf0ed; color: #89958f; font-size: 19rpx; }
.order-item { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; padding: 16rpx 0; }
.item-main { min-width: 0; }
.item-name { color: #34443e; font-size: 22rpx; font-weight: 600; }
.item-spec { margin-top: 6rpx; color: #89958f; font-size: 19rpx; }
.item-price { flex: none; color: #53665e; font-size: 20rpx; }
.order-address, .order-note { margin-top: 8rpx; color: #74827b; font-size: 19rpx; line-height: 1.5; }
.order-foot { display: flex; align-items: center; justify-content: space-between; gap: 10rpx; margin-top: 17rpx; padding-top: 15rpx; border-top: 1rpx solid #edf0ed; }
.order-hint { color: #89958f; font-size: 18rpx; }
.order-sum { flex: none; color: #78857f; font-size: 20rpx; }
.order-sum text { margin-left: 6rpx; color: #bc6a4c; font-size: 25rpx; font-weight: 700; }
.cancel-btn { display: flex; align-items: center; justify-content: center; width: auto; min-width: 0; height: 52rpx; margin: 15rpx 0 0 auto; padding: 0 18rpx; border: 1rpx solid #dfe7e2; border-radius: 27rpx; background: #fff; color: #66766e; font-size: 19rpx; line-height: 1; }
