.legal-page { padding: 36rpx 30rpx calc(60rpx + env(safe-area-inset-bottom)); overflow-wrap: anywhere; }
.title { font-size: 1.375rem; font-weight: 700; }
.version { font-size: .9375rem; color: #56685f; margin: 14rpx 0 30rpx; }
.section { margin-top: 28rpx; padding: 26rpx; background: #fff; border: 1rpx solid #e2eae4; border-radius: 16rpx; }
.heading { margin-bottom: 14rpx; font-size: 1.125rem; font-weight: 650; }
.body { font-size: 1rem; line-height: 1.85; white-space: pre-wrap; }
.hint { padding: 24rpx 0; color: #56685f; font-size: 1rem; }
.contact-button { display: flex; align-items: center; justify-content: center; min-height: 44px; height: auto; margin-top: 34rpx; padding: 20rpx; background: #356e60; border-radius: 16rpx; color: #fff; font-size: 1rem; line-height: 1.6; }
.contact-button::after { border: none; }
