page {
  min-height: 100%;
  background: #f6f7f5;
  color: #24342f;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

.page { width: 100%; min-width: 0; box-sizing: border-box; padding: 0 28rpx 36rpx; }
.topbar { min-height: 112rpx; padding: 18rpx 0; display: flex; flex-wrap: wrap; gap: 16rpx; align-items: center; justify-content: space-between; }
.brand-title { color: #20352f; font-size: 1.3125rem; font-weight: 700; letter-spacing: 1rpx; }
.brand-sub { margin-top: 4rpx; color: #56685f; font-size: 0.9375rem; }
.profile { display: flex; align-items: center; min-height: 44px; padding: 13rpx 18rpx; border: 1rpx solid #e9eeeb; border-radius: 28rpx; background: #fff; color: #52665f; font-size: 1rem; }
.profile-icon { margin-right: 7rpx; color: #4f8d7e; font-size: 1.0625rem; }

.hero { position: relative; overflow: hidden; min-height: 222rpx; box-sizing: border-box; padding: 30rpx; border-radius: 22rpx; background: #315f55; color: #fff; }
.hero::after { position: absolute; top: -105rpx; right: -42rpx; width: 278rpx; height: 278rpx; border: 1rpx solid #ffffff24; border-radius: 50%; box-shadow: 0 0 0 26rpx #ffffff0c, 0 0 0 52rpx #ffffff08; content: ''; }
.hero-tag { display: inline-block; padding: 6rpx 12rpx; border-radius: 20rpx; background: #ffffff1c; color: #e8f1ed; font-size: 0.875rem; }
.hero-title { position: relative; z-index: 1; margin-top: 18rpx; font-size: 1.375rem; font-weight: 650; letter-spacing: 1rpx; }
.hero-copy { position: relative; z-index: 1; margin-top: 9rpx; color: #d8e5df; font-size: 0.9375rem; }
.hero-bubbles { display: none; }

.category-bar { width: 100%; box-sizing: border-box; margin: 22rpx 0; white-space: nowrap; }
.category-chip { display: inline-flex; align-items: center; min-height: 44px; margin-right: 12rpx; padding: 12rpx 22rpx; border: 1rpx solid #e7ece8; border-radius: 26rpx; background: #fff; color: #56685f; font-size: 1rem; }
.category-chip.selected { border-color: #356e60; background: #356e60; color: #fff; }
.empty { padding: 80rpx 0; color: #56685f; text-align: center; font-size: 1rem; }

.section-title { display: flex; flex-wrap: wrap; align-items: center; gap: 8rpx; margin: 26rpx 0 17rpx; color: #2b3934; font-size: 1.125rem; font-weight: 650; }
.section-mark { width: 6rpx; height: 25rpx; margin-right: 12rpx; border-radius: 4rpx; background: #6eaa98; }
.section-note { margin-left: auto; color: #56685f; font-size: 0.875rem; font-weight: 400; }
.brand-section { margin-bottom: 23rpx; }
.brand-heading { margin: 0 0 10rpx 4rpx; color: #56685f; font-size: 0.9375rem; font-weight: 600; }
.product-card { width: 100%; min-width: 0; box-sizing: border-box; margin-bottom: 16rpx; padding: 22rpx; border: 1rpx solid #e9eeeb; border-radius: 18rpx; background: #fff; }
.product-main { display: flex; align-items: center; gap: 20rpx; min-width: 0; }
.product-visual { display: flex; flex: none; width: 122rpx; height: 122rpx; flex-direction: column; align-items: center; justify-content: center; border-radius: 14rpx; background: #edf4f0; color: #648d7f; }
.product-image { display: block; width: 100%; height: 100%; border-radius: 14rpx; background: #fff; }
.water-glyph { font-size: 1.53125rem; font-weight: 600; line-height: 1.1; }
.capacity-label { margin-top: 6rpx; color: #56685f; font-size: 12px; }
.product-info { min-width: 0; flex: 1; overflow-wrap: anywhere; }
.product-name { color: #283a34; font-size: 1.125rem; font-weight: 650; }
.product-spec { margin-top: 6rpx; color: #56685f; font-size: 0.875rem; }
.product-bottom { display: flex; flex-wrap: wrap; gap: 16rpx; align-items: center; justify-content: space-between; width: 100%; box-sizing: border-box; margin-top: 20rpx; }
.product-price { min-width: 0; overflow-wrap: anywhere; }
.price-symbol { color: #a64e32; font-size: 1rem; font-weight: 600; }
.price { margin-left: 2rpx; color: #a64e32; font-size: 1.25rem; font-weight: 700; }
.unit { color: #56685f; font-size: 0.875rem; }
.stepper { display: inline-flex; flex: none; align-items: center; gap: 8rpx; max-width: 100%; margin-left: auto; }
.step-btn { display: flex; flex: none; align-items: center; justify-content: center; box-sizing: border-box; width: 44px; height: 44px; padding: 0; border: 1rpx solid #b8cbc0; border-radius: 50%; background: #fff; color: #356e60; font-size: 28px; line-height: 1; text-align: center; }
.step-btn.plus { border-color: #356e60; background: #356e60; color: #fff; }
.step-btn-hover { opacity: .72; transform: scale(.96); }
.quantity { display: block; min-width: 2.25rem; color: #34443e; font-size: 1.125rem; text-align: center; font-variant-numeric: tabular-nums; }
.stock-tip { margin-top: 6rpx; color: #56685f; font-size: 0.875rem; text-align: right; }
.sold-out { color: #56685f; font-size: 0.875rem; }
.bottom-space { height: calc(8rem + 40rpx); }

.cart-bar { position: fixed; z-index: 5; right: 0; bottom: 0; left: 0; display: flex; flex-wrap: wrap; gap: 16rpx; align-items: center; justify-content: space-between; box-sizing: border-box; padding: 16rpx 28rpx; border-top: 1rpx solid #e6ece8; background: #fff; box-shadow: 0 -4rpx 16rpx #253d3208; }
.cart-summary { min-width: 0; flex: 1 1 240rpx; overflow-wrap: anywhere; }
.cart-count { display: inline-flex; min-width: 1.5rem; align-items: center; justify-content: center; box-sizing: border-box; padding: 0 7rpx; border-radius: 20rpx; background: #eaf3ef; color: #356e60; font-size: 0.875rem; }
.cart-label { margin-left: 8rpx; color: #66746e; font-size: 0.875rem; }
.cart-total { display: block; color: #283a34; font-size: 1.25rem; font-weight: 700; }
.checkout-btn, .primary-btn { display: flex; align-items: center; justify-content: center; box-sizing: border-box; margin: 0; padding: .6rem 22rpx; min-height: 2.75rem; height: auto; border: 0; border-radius: 16rpx; background: #356e60; color: #fff; font-size: 1.125rem; font-weight: 600; line-height: 1.4; }
.checkout-btn { flex: 0 1 auto; width: auto; min-width: 6rem; max-width: 100%; }
.checkout-btn::after, .primary-btn::after, .secondary-btn::after { border: 0; }

.modal-mask { position: fixed; z-index: 9; inset: 0; display: flex; align-items: center; justify-content: center; box-sizing: border-box; padding: 28rpx; background: #17282080; }
.modal-card { width: 100%; box-sizing: border-box; padding: 30rpx 26rpx 26rpx; border: 1rpx solid #e8ede9; border-radius: 22rpx; background: #fff; box-shadow: 0 16rpx 48rpx #1a302733; }
.modal-title { color: #263832; font-size: 1.1875rem; font-weight: 700; }
.modal-copy { margin: 10rpx 0 22rpx; color: #56685f; font-size: 0.9375rem; line-height: 1.5; }
.field { display: block; flex-shrink: 0; width: 100%; box-sizing: border-box; margin-bottom: 12rpx; padding: 17rpx 18rpx; border: 1rpx solid #e8ede9; border-radius: 12rpx; background: #f8faf8; color: #34443e; font-size: 0.9375rem; }
.primary-btn { width: 100%; min-width: 0; margin-top: 6rpx; }
.checkout-modal { display: block; max-height: 88vh; overflow-y: auto; align-self: flex-end; margin-bottom: 8rpx; }
.checkout-summary { flex: none; margin: 10rpx 0 14rpx; color: #56685f; font-size: 0.875rem; }
.checkout-total { color: #a64e32; font-size: 1rem; font-weight: 700; }
.checkout-items { margin-bottom: 12rpx; border-top: 1rpx solid #edf0ed; border-bottom: 1rpx solid #edf0ed; }
.checkout-item { display: flex; flex-wrap: wrap; min-height: 74rpx; align-items: center; justify-content: space-between; gap: 14rpx; padding: 16rpx 2rpx; box-sizing: border-box; }
.checkout-item + .checkout-item { border-top: 1rpx solid #f0f2f0; }
.checkout-item-main { min-width: 0; flex: 1 1 240rpx; overflow-wrap: anywhere; }
.checkout-item-name { color: #34443e; font-size: 1.125rem; font-weight: 600; }
.checkout-item-spec { margin-top: 5rpx; color: #56685f; font-size: 0.875rem; }
.checkout-item-total { max-width: 100%; overflow-wrap: anywhere; color: #4b5d55; font-size: 1rem; }
.address-field { height: 5rem; min-height: 5rem; margin: 16rpx 0; font-size: 1.125rem; line-height: 1.55; }
.note-field { height: 3rem; min-height: 3rem; font-size: 1.125rem; line-height: normal; }
.checkout-actions { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 20rpx; }
.checkout-actions button { flex: 1 1 240rpx; min-height: 2.75rem; height: auto; width: 0; min-width: 0; margin: 0; padding: .6rem 16rpx; font-size: 1.125rem; }
.secondary-btn { display: flex; align-items: center; justify-content: center; box-sizing: border-box; border: 1rpx solid #c7d6cd; border-radius: 16rpx; background: #fff; color: #465b50; line-height: 1.4; }
.coupon-selector { display: flex; justify-content: space-between; gap: 12rpx; padding: 14rpx 0; color: #477568; font-size: 0.9375rem; }
.coupon-selector text:last-child { flex: 1; min-width: 0; text-align: right; word-break: break-all; }
.coupon-rule-tip { color: #56685f; font-size: 0.875rem; line-height: 1.5; }
.checkout-discount { display: flex; flex-wrap: wrap; gap: 12rpx; align-items: center; justify-content: space-between; margin: 8rpx 0 18rpx; color: #56685f; font-size: 1rem; overflow-wrap: anywhere; }
.checkout-discount text { color: #a64e32; font-size: 1.0625rem; font-weight: 650; }
.reading-large .product-main { align-items: flex-start; }
.reading-large .product-visual { width: 122rpx; height: 122rpx; }
.reading-large .water-glyph { font-size: 24px; }
.reading-large .capacity-label { display: none; }
.reading-large .section-note { display: none; }
.reading-large .checkout-actions { flex-direction: column; }
.reading-large .checkout-actions button { flex: none; width: 100%; }
