page {
  min-height: 100%;
  background: #f6f7f5;
  color: #24342f;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

.page { padding: 0 28rpx 36rpx; }
.topbar { height: 112rpx; display: flex; align-items: center; justify-content: space-between; }
.brand-title { color: #20352f; font-size: 35rpx; font-weight: 700; letter-spacing: 1rpx; }
.brand-sub { margin-top: 4rpx; color: #87938e; font-size: 21rpx; }
.profile { padding: 13rpx 18rpx; border: 1rpx solid #e9eeeb; border-radius: 28rpx; background: #fff; color: #52665f; font-size: 22rpx; }
.profile-icon { margin-right: 7rpx; color: #4f8d7e; font-size: 25rpx; }

.hero { position: relative; overflow: hidden; height: 222rpx; box-sizing: border-box; padding: 30rpx; border-radius: 22rpx; background: #315f55; color: #fff; }
.hero::after { position: absolute; top: -105rpx; right: -42rpx; width: 278rpx; height: 278rpx; border: 1rpx solid #ffffff24; border-radius: 50%; box-shadow: 0 0 0 26rpx #ffffff0c, 0 0 0 52rpx #ffffff08; content: ''; }
.hero-tag { display: inline-block; padding: 6rpx 12rpx; border-radius: 20rpx; background: #ffffff1c; color: #e8f1ed; font-size: 19rpx; }
.hero-title { position: relative; z-index: 1; margin-top: 18rpx; font-size: 37rpx; font-weight: 650; letter-spacing: 1rpx; }
.hero-copy { position: relative; z-index: 1; margin-top: 9rpx; color: #d8e5df; font-size: 22rpx; }
.hero-bubbles { position: absolute; z-index: 1; right: 24rpx; bottom: 26rpx; color: #ffffff69; font-size: 21rpx; letter-spacing: 7rpx; transform: rotate(-12deg); }

.category-bar { margin: 22rpx -28rpx 22rpx; padding: 0 28rpx; white-space: nowrap; }
.category-chip { display: inline-block; margin-right: 12rpx; padding: 12rpx 22rpx; border: 1rpx solid #e7ece8; border-radius: 26rpx; background: #fff; color: #687770; font-size: 21rpx; }
.category-chip.selected { border-color: #356e60; background: #356e60; color: #fff; }
.empty { padding: 80rpx 0; color: #87938e; text-align: center; font-size: 24rpx; }

.section-title { display: flex; align-items: center; margin: 26rpx 0 17rpx; color: #2b3934; font-size: 28rpx; font-weight: 650; }
.section-mark { width: 6rpx; height: 25rpx; margin-right: 12rpx; border-radius: 4rpx; background: #6eaa98; }
.section-note { margin-left: auto; color: #9aa49f; font-size: 19rpx; font-weight: 400; }
.brand-section { margin-bottom: 23rpx; }
.brand-heading { margin: 0 0 10rpx 4rpx; color: #73817b; font-size: 21rpx; font-weight: 600; }
.product-card { display: flex; align-items: center; box-sizing: border-box; margin-bottom: 12rpx; padding: 16rpx; border: 1rpx solid #e9eeeb; border-radius: 18rpx; background: #fff; }
.product-visual { display: flex; flex: none; width: 122rpx; height: 122rpx; flex-direction: column; align-items: center; justify-content: center; border-radius: 14rpx; background: #edf4f0; color: #648d7f; }
.water-glyph { font-size: 43rpx; font-weight: 600; line-height: 1.1; }
.capacity-label { margin-top: 6rpx; color: #839a90; font-size: 17rpx; }
.product-info { min-width: 0; flex: 1; margin-left: 17rpx; }
.product-name { overflow: hidden; color: #283a34; font-size: 25rpx; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
.product-spec { margin-top: 6rpx; color: #929d97; font-size: 19rpx; }
.product-bottom { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; margin-top: 16rpx; }
.product-price { flex: none; white-space: nowrap; }
.price-symbol { color: #bc6a4c; font-size: 20rpx; font-weight: 600; }
.price { margin-left: 2rpx; color: #bc6a4c; font-size: 29rpx; font-weight: 700; }
.unit { color: #929d97; font-size: 17rpx; }
.stepper { display: flex; flex: none; align-items: center; gap: 4rpx; }
.step-btn { display: flex; flex: none; align-items: center; justify-content: center; box-sizing: border-box; width: 46rpx; min-width: 46rpx; height: 46rpx; margin: 0; padding: 0; border: 1rpx solid #dce6e1; border-radius: 50%; background: #fff; color: #477568; font-size: 25rpx; line-height: 1; }
.step-btn.plus { border-color: #356e60; background: #356e60; color: #fff; }
.step-btn::after { border: 0; }
.quantity { min-width: 32rpx; color: #34443e; text-align: center; font-size: 21rpx; }
.stock-tip { margin-top: 6rpx; color: #9ca7a2; font-size: 17rpx; text-align: right; }
.sold-out { color: #929d97; font-size: 19rpx; }
.bottom-space { height: 112rpx; }

.cart-bar { position: fixed; z-index: 5; right: 20rpx; bottom: calc(18rpx + constant(safe-area-inset-bottom)); bottom: calc(18rpx + env(safe-area-inset-bottom)); left: 20rpx; display: flex; height: 92rpx; align-items: center; justify-content: space-between; box-sizing: border-box; padding: 0 12rpx 0 22rpx; border: 1rpx solid #e6ece8; border-radius: 48rpx; background: #fff; box-shadow: 0 7rpx 24rpx #253d3214; }
.cart-summary { display: flex; min-width: 0; flex: 1; align-items: center; justify-content: space-between; padding-right: 10rpx; }
.cart-count { display: inline-flex; min-width: 34rpx; height: 34rpx; align-items: center; justify-content: center; box-sizing: border-box; padding: 0 7rpx; border-radius: 20rpx; background: #eaf3ef; color: #356e60; font-size: 19rpx; }
.cart-label { margin-left: 8rpx; color: #66746e; font-size: 20rpx; }
.cart-total { margin-left: 10rpx; color: #283a34; font-size: 27rpx; font-weight: 700; white-space: nowrap; }
.checkout-btn, .primary-btn { display: flex; align-items: center; justify-content: center; box-sizing: border-box; margin: 0; padding: 0 22rpx; border: 0; border-radius: 36rpx; background: #356e60; color: #fff; font-size: 23rpx; font-weight: 600; line-height: 1; }
.checkout-btn { width: 172rpx; min-width: 172rpx; height: 66rpx; }
.checkout-btn::after, .primary-btn::after, .secondary-btn::after { border: 0; }

.modal-mask { position: fixed; z-index: 9; inset: 0; display: flex; align-items: center; justify-content: center; box-sizing: border-box; padding: 28rpx; background: #17282080; }
.modal-card { width: 100%; box-sizing: border-box; padding: 30rpx 26rpx 26rpx; border: 1rpx solid #e8ede9; border-radius: 22rpx; background: #fff; box-shadow: 0 16rpx 48rpx #1a302733; }
.modal-title { color: #263832; font-size: 30rpx; font-weight: 700; }
.modal-copy { margin: 10rpx 0 22rpx; color: #7c8983; font-size: 21rpx; line-height: 1.5; }
.field { display: block; width: 100%; box-sizing: border-box; margin-bottom: 12rpx; padding: 17rpx 18rpx; border: 1rpx solid #e8ede9; border-radius: 12rpx; background: #f8faf8; color: #34443e; font-size: 22rpx; }
.primary-btn { width: 100%; min-width: 0; height: 72rpx; margin-top: 6rpx; font-size: 22rpx; }
.checkout-modal { display: flex; max-height: 88vh; flex-direction: column; overflow: hidden; align-self: flex-end; margin-bottom: calc(8rpx + env(safe-area-inset-bottom)); }
.checkout-summary { flex: none; margin: 10rpx 0 14rpx; color: #7c8983; font-size: 20rpx; }
.checkout-total { color: #bc6a4c; font-size: 24rpx; font-weight: 700; }
.checkout-items { flex: none; max-height: 250rpx; margin-bottom: 12rpx; border-top: 1rpx solid #edf0ed; border-bottom: 1rpx solid #edf0ed; }
.checkout-item { display: flex; min-height: 74rpx; align-items: center; justify-content: space-between; gap: 14rpx; padding: 10rpx 2rpx; box-sizing: border-box; }
.checkout-item + .checkout-item { border-top: 1rpx solid #f0f2f0; }
.checkout-item-main { min-width: 0; flex: 1; }
.checkout-item-name { overflow: hidden; color: #34443e; font-size: 21rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.checkout-item-spec { margin-top: 5rpx; color: #8a9690; font-size: 18rpx; }
.checkout-item-total { flex: none; color: #4b5d55; font-size: 20rpx; }
.address-field { height: 86rpx; min-height: 86rpx; margin-bottom: 10rpx; }
.note-field { height: 68rpx; min-height: 68rpx; }
.checkout-actions { display: flex; flex: none; gap: 12rpx; margin-top: 4rpx; }
.checkout-actions button { flex: 1; height: 68rpx; min-width: 0; margin: 0; font-size: 21rpx; }
.secondary-btn { display: flex; align-items: center; justify-content: center; box-sizing: border-box; border: 1rpx solid #dfe7e2; border-radius: 36rpx; background: #fff; color: #586a62; line-height: 1; }
