page { min-height: 100%; background: #f5f8fb; color: #18344b; font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif; }
.page { padding: 0 30rpx 32rpx; }
.topbar { height: 116rpx; display: flex; justify-content: space-between; align-items: center; }
.brand-title { font-size: 36rpx; font-weight: 700; letter-spacing: 2rpx; }
.brand-sub { color: #8da0ad; font-size: 21rpx; margin-top: 3rpx; letter-spacing: 2rpx; }
.profile { background: #fff; border-radius: 32rpx; padding: 14rpx 20rpx; font-size: 23rpx; color: #537287; box-shadow: 0 5rpx 18rpx #13344b0a; }
.profile-icon { margin-right: 8rpx; color: #36a6a0; font-size: 28rpx; }
.hero { position: relative; overflow: hidden; height: 242rpx; padding: 34rpx 34rpx; box-sizing: border-box; border-radius: 26rpx; background: linear-gradient(116deg, #176f93, #31aaa2); color: #fff; }
.hero::after { content: ''; position: absolute; width: 290rpx; height: 290rpx; border: 1rpx solid #ffffff25; border-radius: 50%; right: -75rpx; top: -98rpx; box-shadow: 0 0 0 30rpx #ffffff0c, 0 0 0 60rpx #ffffff0a; }
.hero-tag { display: inline-block; padding: 7rpx 14rpx; border-radius: 24rpx; background: #ffffff26; font-size: 20rpx; letter-spacing: 1rpx; }
.hero-title { margin-top: 20rpx; font-size: 40rpx; font-weight: 700; letter-spacing: 2rpx; }
.hero-copy { margin-top: 10rpx; color: #d5f3f1; font-size: 23rpx; }
.hero-bubbles { position: absolute; right: 38rpx; bottom: 39rpx; color: #d4f5f0a8; font-size: 25rpx; letter-spacing: 9rpx; transform: rotate(-13deg); }
.category-bar { white-space: nowrap; margin: 26rpx -30rpx 24rpx; padding: 0 30rpx; }
.category-chip { display: inline-block; margin-right: 14rpx; padding: 13rpx 25rpx; border-radius: 26rpx; background: #fff; color: #778d9c; font-size: 23rpx; }
.category-chip.selected { background: #1d869e; color: white; box-shadow: 0 7rpx 15rpx #1d869e30; }
.section-title { display: flex; align-items: center; margin: 28rpx 0 18rpx; font-size: 29rpx; font-weight: 700; }
.section-mark { width: 7rpx; height: 28rpx; margin-right: 13rpx; border-radius: 8rpx; background: #3cb1a4; }
.section-note { margin-left: auto; color: #9baeb9; font-size: 20rpx; font-weight: 400; }
.brand-section { margin-bottom: 26rpx; }
.brand-heading { margin: 0 0 12rpx 5rpx; color: #7893a4; font-size: 22rpx; font-weight: 600; }
.product-card { display: flex; align-items: center; margin-bottom: 14rpx; padding: 18rpx; border-radius: 20rpx; background: #fff; box-shadow: 0 7rpx 24rpx #1434490a; }
.product-art { position: relative; flex-shrink: 0; width: 146rpx; height: 164rpx; border-radius: 16rpx; display: flex; align-items: flex-end; justify-content: center; overflow: hidden; box-shadow: inset 0 0 35rpx #ffffff38; }
.product-art::before { content: ''; position: absolute; width: 92rpx; height: 110rpx; border: 2rpx solid #ffffff55; border-bottom: 0; border-radius: 38rpx 38rpx 8rpx 8rpx; top: 35rpx; background: #ffffff16; }
.art-cap { position: absolute; top: 22rpx; width: 29rpx; height: 19rpx; border-radius: 4rpx; background: #ffffffa8; z-index: 1; }
.art-label { z-index: 2; width: 84rpx; height: 57rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; margin-bottom: 40rpx; border-radius: 7rpx; background: #ffffffdf; color: #37788a; }
.art-brand { max-width: 78rpx; overflow: hidden; white-space: nowrap; font-size: 13rpx; }
.art-size { margin-top: 4rpx; font-size: 14rpx; }
.art-mark { position: absolute; color: #ffffff6b; font-size: 40rpx; font-weight: 700; right: 8rpx; bottom: -3rpx; }
.product-info { min-width: 0; flex: 1; margin-left: 21rpx; }
.product-name { overflow: hidden; color: #19384e; font-size: 27rpx; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
.product-spec { margin-top: 7rpx; color: #91a4b0; font-size: 21rpx; }
.product-bottom { display: flex; justify-content: space-between; align-items: center; margin-top: 22rpx; }
.price-symbol { color: #ef825b; font-size: 22rpx; font-weight: 600; }
.price { margin-left: 3rpx; color: #e66f4d; font-size: 34rpx; font-weight: 700; }
.unit { color: #9cadb7; font-size: 19rpx; }
.stepper { display: flex; align-items: center; }
.step-btn { width: 45rpx; height: 45rpx; margin: 0; padding: 0; border: 1rpx solid #d9e7e9; border-radius: 50%; background: #fff; color: #438e9c; font-size: 28rpx; line-height: 42rpx; }
.step-btn::after { border: none; }
.step-btn.plus { border: 0; background: #2a9d9c; color: white; }
.quantity { min-width: 43rpx; text-align: center; font-size: 23rpx; }
.stock-tip { margin-top: 6rpx; color: #a6b5bd; font-size: 18rpx; text-align: right; }
.sold-out { color: #a6b1b6; font-size: 21rpx; }
.empty { padding: 90rpx 0; color: #92a5af; text-align: center; font-size: 25rpx; }
.bottom-space { height: 38rpx; }
.cart-bar { position: fixed; z-index: 5; bottom: 22rpx; left: 24rpx; right: 24rpx; height: 96rpx; padding: 0 16rpx 0 26rpx; display: flex; align-items: center; justify-content: space-between; border-radius: 54rpx; background: #173c4e; color: white; box-shadow: 0 10rpx 32rpx #13394b44; }
.cart-count { display: inline-flex; min-width: 36rpx; height: 36rpx; padding: 0 5rpx; align-items: center; justify-content: center; border-radius: 50%; background: #45b3a6; font-size: 20rpx; }
.cart-label { margin-left: 11rpx; color: #d4e4e8; font-size: 22rpx; }
.cart-total { margin-left: 18rpx; color: white; font-size: 31rpx; font-weight: 700; }
.checkout-btn, .primary-btn { margin: 0; border: 0; border-radius: 40rpx; background: #42b5a5; color: #fff; font-size: 26rpx; font-weight: 600; }
.checkout-btn { min-width: 160rpx; height: 70rpx; line-height: 70rpx; }
.checkout-btn::after, .primary-btn::after, .secondary-btn::after { border: none; }
.modal-mask { position: fixed; z-index: 9; inset: 0; display: flex; align-items: center; justify-content: center; padding: 36rpx; background: #122c3b80; }
.modal-card { width: 100%; padding: 38rpx 32rpx 32rpx; box-sizing: border-box; border-radius: 28rpx; background: #fff; box-shadow: 0 20rpx 70rpx #061d2c35; }
.modal-title { color: #17394d; font-size: 34rpx; font-weight: 700; }
.modal-copy { margin: 12rpx 0 28rpx; color: #8aa0ad; font-size: 22rpx; }
.field { width: 100%; min-height: 82rpx; box-sizing: border-box; margin-bottom: 16rpx; padding: 22rpx; border-radius: 15rpx; background: #f3f7f8; color: #244458; font-size: 24rpx; }
.primary-btn { width: 100%; height: 82rpx; line-height: 82rpx; }
.checkout-modal { align-self: flex-end; margin-bottom: 10rpx; }
.checkout-summary { margin: 17rpx 0 23rpx; color: #8095a1; font-size: 23rpx; }
.checkout-total { color: #e77654; font-size: 28rpx; font-weight: 700; }
.address-field { height: 130rpx; }
.note-field { height: 95rpx; }
.checkout-actions { display: flex; gap: 18rpx; }
.checkout-actions button { flex: 1; }
.secondary-btn { margin: 0; border: 1rpx solid #d9e5e9; border-radius: 40rpx; background: #fff; color: #5c7584; font-size: 25rpx; }
